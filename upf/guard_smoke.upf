upf_version 2.1

# Elaborated simulation top
set_design_top tb_top

# ------------------------------------------------------------
# Supply network
# These MUST exist before the supply set references them.
# ------------------------------------------------------------

create_supply_net VDD
create_supply_net VSS

# ------------------------------------------------------------
# Supply set
# ------------------------------------------------------------

create_supply_set SS_TB \
    -function {power VDD} \
    -function {ground VSS}

# ------------------------------------------------------------
# Default power domain
# ------------------------------------------------------------

create_power_domain PD_TB \
    -include_scope \
    -supply {primary SS_TB}