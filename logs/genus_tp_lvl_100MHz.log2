#@ Begin verbose source ubc/ece/home/ugrads/r/rkaisaan/thesis/genus_frequency_sweep/constraints.tcl
@file(constraints.tcl) 2: set clk_pin  clk
@file(constraints.tcl) 3: set rstn_pin rst_n
@file(constraints.tcl) 6: set clk_period  $CLK_PERIOD_NS
@file(constraints.tcl) 7: set eighth      [expr {$clk_period / 8.0}]
@file(constraints.tcl) 8: set quarter     [expr {$clk_period / 4.0}]
@file(constraints.tcl) 9: set half_period [expr {$clk_period / 2.0}]
@file(constraints.tcl) 12: set inputs_no_clk_rstn \
    [remove_from_collection [all_inputs] [get_ports "$clk_pin $rstn_pin"]]
@file(constraints.tcl) 16: create_clock [get_ports $clk_pin] \
    -name core_clk \
    -period $clk_period \
    -waveform [list 0 $half_period]
@file(constraints.tcl) 21: create_clock \
    -name io_virtual_clk \
    -period $clk_period
@file(constraints.tcl) 26: set_driving_cell \
    -lib_cell DFFX1 \
    -input_transition_rise $eighth \
    -input_transition_fall $eighth \
    $inputs_no_clk_rstn
@file(constraints.tcl) 33: set_load \
    [expr {[load_of [get_lib_pins */NAND2X4/A]] * 4}] \
    [all_outputs]
@file(constraints.tcl) 38: set_input_delay \
    -max $quarter \
    -clock io_virtual_clk \
    $inputs_no_clk_rstn
@file(constraints.tcl) 43: set_output_delay \
    -max $quarter \
    -clock io_virtual_clk \
    [all_outputs]
@file(constraints.tcl) 49: set_clock_uncertainty $eighth [get_clocks core_clk]
@file(constraints.tcl) 50: set_clock_latency     $eighth [get_clocks core_clk]
@file(constraints.tcl) 53: set_false_path -from [get_ports $rstn_pin]
